"""
Claude API Client: Call Claude for rental explanations
Uses: anthropic library + .env for API key
"""

import os
from anthropic import Anthropic
from dotenv import load_dotenv

# Load API key from .env file
load_dotenv()
ANTHROPIC_API_KEY = os.getenv('ANTHROPIC_API_KEY')

if not ANTHROPIC_API_KEY:
    raise ValueError("❌ ANTHROPIC_API_KEY not set in .env file!")


def call_claude_api(suburb, bedrooms, predicted_rent, median_income, SEIFA, distance_cbd):
    """
    Call Claude API to generate AI explanation for rental prediction
    
    Args:
        suburb (str): Suburb name (e.g. "Footscray")
        bedrooms (int): Number of bedrooms (2, 3, or 4)
        predicted_rent (float): Predicted weekly rent (e.g. 450.50)
        median_income (float): Median income in suburb (e.g. 75000)
        SEIFA (float): SEIFA index score (e.g. 1020)
        distance_cbd (float): Distance to CBD in km (e.g. 8.5)
    
    Returns:
        str: Natural language explanation from Claude
    """
    
    # Initialize Anthropic client
    client = Anthropic()
    
    # Create the prompt for Claude
    prompt = f"""
You are a rental market expert explaining fair rental prices. The user has a rental prediction.

**Prediction Details:**
- Suburb: {suburb}
- Bedrooms: {bedrooms}
- Fair weekly rent: ${predicted_rent:.0f}
- Median household income: ${median_income:,.0f}
- SEIFA (area affluence): {SEIFA:.0f} (national average: 1000)
- Distance to CBD: {distance_cbd:.1f} km

Write a SHORT (2–3 sentences), natural explanation of WHY this suburb has this rent level.
Focus on:
1. The suburb's location/affluence
2. How income affects rent
3. Comparison to average (if applicable)

Format: Plain text, no markdown, conversational tone.
Example: "This inner-west suburb commands a premium due to its close proximity to the CBD and strong household income base. The affluence index of 1020 indicates above-average wealth, which naturally drives rental prices higher..."

NOW WRITE THE EXPLANATION:
"""
    
    # Call Claude API
    message = client.messages.create(
        model="claude-opus-4-6",  # Fast, accurate model
        max_tokens=150,           # Keep it short
        messages=[
            {
                "role": "user",
                "content": prompt
            }
        ]
    )
    
    # Extract and return explanation
    explanation = message.content[0].text
    return explanation


# Test the function (run this to verify API works)
if __name__ == "__main__":
    print("🧪 Testing Claude API...")
    
    explanation = call_claude_api(
        suburb="Footscray",
        bedrooms=3,
        predicted_rent=450.50,
        median_income=75000,
        SEIFA=1020,
        distance_cbd=8.5
    )
    
    print(f"\n✅ Explanation generated:\n{explanation}")
