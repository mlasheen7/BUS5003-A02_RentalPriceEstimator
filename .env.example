# AI explanations (app/utils/api_client.py) - calls go through OpenRouter,
# so the model can be swapped by changing EXPLAIN_MODEL, with no code change.
# Get a key at https://openrouter.ai/keys and set a spending limit on it.
OPENROUTER_API_KEY=your_openrouter_key_here
EXPLAIN_MODEL=openai/gpt-4o-mini

# Google Cloud (BigQuery)
GOOGLE_PROJECT_ID=your_project_id
GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json

# Database Configuration (if using PostgreSQL)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=rental_estimator
# DB_USER=postgres
# DB_PASSWORD=your_password

# Streamlit Configuration (for deployment)
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Development Settings
DEBUG=True
DATA_PATH=data/processed/
MODEL_PATH=models/