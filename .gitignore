# NOTE: .gitignore does NOT support trailing comments on a pattern line.
# Anything after a pattern (including "# ...") becomes part of the pattern.
# Put comments on their own line only.

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ===== Virtual Environment =====
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/

# ===== IDE =====
.vscode/
.idea/
*.swp
*.swo
*~

# ===== Environment Variables & Secrets =====
.env
.env.local
.env.*.local
secrets.json
.streamlit/secrets.toml

# ===== Data =====
# Raw source files are never committed, but the folder itself is kept
# so a fresh clone has the directory the pipeline and tests expect.
/data/raw/*
!/data/raw/.gitkeep
/data/*.csv
/data/*.xlsx
/data/*.parquet
!/data/.gitkeep
# data/processed/ IS committed on purpose - see data/README.md.
# The files are small (<500 KB total) and cannot be regenerated without
# the raw files, which are not in the repo.

# ===== Models (Large Binary Files) =====
/models/*.pkl
/models/*.joblib
/models/*.h5
/models/*.pt
/models/*.json
!/models/.gitkeep

# ===== Notebooks (Jupyter) =====
.ipynb_checkpoints/
*.ipynb_checkpoints

# ===== Logs & Outputs =====
/logs/
*.log
/outputs/
/reports/*.html

# ===== OS Files =====
.DS_Store
Thumbs.db

# ===== Testing =====
.pytest_cache/
.coverage
coverage.xml
htmlcov/
